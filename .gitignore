# MedMind — .gitignore

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Environment
.env
.env.*
backend/.env
.venv/
venv/

# Runtime data (generated locally, not shared)
vector_store/
backend/vector_store/
profiles/
backend/profiles/
history/
backend/history/

# Eval outputs (regenerated per machine)
eval/results.jsonl
eval/summary.json

# Build artifacts
*.egg-info/
dist/
build/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Misc
misc_assets/
*.log
